plugin core;
plugin mem;
plugin compile;
plugin direct;
plugin aie2p;

import compile;
import direct;

lam extern _compile (): %compile.Phase =
    %compile.phases ff (
        %aie2p.lower_aie2p_phase,
        direct_phases,
        %compile.internal_cleanup_phase,
        %compile.branch_normalize_phase,
        %compile.ret_wrap_phase
    );

// Single mac_4x4x8 call + SRS to verify lane mapping.
// A: 32 i16 packed as 16 i32 (512 bits)
// B: 32 i16 (512 bits)
// C_out: 32 i16 (512 bits)
con extern matmul_probe [
    mem: %mem.M 0,
    A: %mem.Ptr («16; I32», 0),
    B: %mem.Ptr («32; I16», 0),
    C_out: %mem.Ptr («32; I16», 0),
    return: Cn [%mem.M 0]
] =
    let (mem, a_vec) = %mem.load (mem, A);
    let (mem, b_vec) = %mem.load (mem, B);
    let zero_acc = ‹32; 0:I64›;
    // conf=26: unsigned mac_4x4_4x8 matmul
    let acc = %aie2p.mac_4x4x8 (a_vec, b_vec, zero_acc, 26I32);
    let result = %aie2p.srs_i16_32 (acc, 0I32, 0I32);
    let mem = %mem.store (mem, C_out, result);
    return (mem);
