plugin core;
plugin mem;
plugin compile;
plugin direct;
plugin aie2p;

import compile;
import direct;

lam extern _compile (): %compile.Phase =
    %compile.phases ff (
        %aie2p.lower_aie2p_phase,
        direct_phases,
        %compile.internal_cleanup_phase,
        %compile.branch_normalize_phase,
        %compile.ret_wrap_phase
    );

let K_nat = ⊤:Nat;

// Minimal MAC probe: single MAC + SRS, no loop.
// Reads only A[0] and B[0], ignoring rows 1-3.
// Signature matches IRON ABI: void @mac_probe([4x<32xi16>]*, [4x<32xi16>]*, [16xi32]*)
con extern mac_probe [
    mem: %mem.M 0,
    A: %mem.Ptr («4; «32; I16»», 0),
    B: %mem.Ptr («4; «32; I16»», 0),
    C_out: %mem.Ptr («16; I32», 0),
    return: Cn [%mem.M 0]
] =
    // Load A[0] and B[0]
    let idx0 = %core.conv.u K_nat 0I32;
    let a_lea = %mem.lea (A, idx0);
    let (mem, a_vec) = %mem.load (mem, a_lea);
    let b_lea = %mem.lea (B, idx0);
    let (mem, b_vec) = %mem.load (mem, b_lea);

    // Single MAC with zero accumulator
    let zero_acc = ‹16; 0:I64›;
    // conf=90 for mac_elem_16_2 unsigned: amode=1, bmode=3, variant=2
    // = (1<<1) | (3<<3) | (2<<5) = 2 + 24 + 64 = 90
    let acc = %aie2p.mac_i16_i64 (a_vec, b_vec, zero_acc, 90I32);

    // SRS with shift=0, round=0 to convert to i32
    let result = %aie2p.srs_i32_16 (acc, 0I32, 0I32);

    // Store and return
    let mem = %mem.store (mem, C_out, result);
    return (mem);
