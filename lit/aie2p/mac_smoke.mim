plugin core;
plugin compile;
plugin direct;
plugin aie2p;

import compile;
import direct;

lam extern _compile (): %compile.Phase =
    %compile.phases ff (
        %aie2p.lower_aie2p_phase,
        direct_phases,
        %compile.internal_cleanup_phase,
        %compile.branch_normalize_phase,
        %compile.ret_wrap_phase
    );

con extern mac_test(a: «32; I16», b: «32; I16», acc: «16; I64», conf: I32,
                    return: Cn [«16; I64»]) =
    let result = %aie2p.mac_i16_i64 (a, b, acc, conf);
    return (result);
