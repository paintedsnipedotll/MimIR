plugin core;
plugin compile;
plugin direct;
plugin aie2p;

import compile;
import direct;

lam extern _compile (): %compile.Phase =
    %compile.phases ff (
        %aie2p.lower_aie2p_phase,
        direct_phases,
        %compile.internal_cleanup_phase,
        %compile.branch_normalize_phase,
        %compile.ret_wrap_phase
    );

con extern srs16_test(acc: «16; I64», shift: I32, round: I32,
                      return: Cn [«16; I32»]) =
    let result = %aie2p.srs_i32_16 (acc, shift, round);
    return (result);
